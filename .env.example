# jlcpcb-mcp configuration (all optional — the live API needs no credentials)

# Override where the local catalog SQLite database is stored.
# Defaults to a platform-specific data dir, e.g.:
#   Windows: %LOCALAPPDATA%\jlcpcb-mcp\components.sqlite
#   macOS:   ~/Library/Application Support/jlcpcb-mcp/components.sqlite
#   Linux:   ~/.local/share/jlcpcb-mcp/components.sqlite
# JLCPCB_DATABASE_PATH=./data/components.sqlite

# Development mode: store the database in ./data within the project root.
# JLCPCB_DEV_MODE=1

# --- Official JLCPCB Open API (optional) -------------------------------------
# Only needed for the `jlcpcb_official_*` tools. Apply for access at
# https://api.jlcpcb.com. The catalog/live tools work without these.
# JLCPCB_APP_ID=your_app_id
# JLCPCB_ACCESS_KEY=your_access_key
# JLCPCB_SECRET_KEY=your_secret_key
# Override the API base (defaults to https://open.jlcpcb.com):
# JLCPCB_ENDPOINT=https://open.jlcpcb.com
# JLCPCB_CONTEXT_PATH=
